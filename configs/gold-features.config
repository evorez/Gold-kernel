# gold-features.config - the one list of kernel options this build turns on.
#
# Format (parsed by scripts/apply-tweaks.sh, checked by scripts/verify-build.sh):
#   REQ CONFIG_FOO=y     must end up in the built Image, build fails otherwise
#   REQ !CONFIG_FOO      must be absent/off in the built Image
#   OPT CONFIG_FOO=y     best effort: applied, but only a warning if the kernel
#                        does not offer it (source absent, dependency missing)
#
# Everything here is a config option of the GKI Image. Nothing here renames,
# retypes or removes an exported symbol - the prebuilt MediaTek modules in
# vendor_dlkm / vendor_boot / system_dlkm keep their CRCs and keep loading.
#
# Deliberately NOT config options (see docs/FEATURES.md):
#   * MTK FPSGO / GED / PPM / PBM, GPU DVFS, CPU/GPU OPP tables, UFS, thermal
#     trips, charging: MediaTek vendor modules, already on the device and kept
#     compatible by the KMI gate. Rebuilding them would mean the mgk_64_k66
#     vendor build, not this Image.
#   * zram itself: the ROM loads Google's zram.ko; flipping it to =y here would
#     not change the module that actually runs. We only make sure the compression
#     algorithms it can use are available.
#   * fsync, TRIM/discard: behaviour, not config - and both stay at stock.

# ─────────────────────────────── BASE ───────────────────────────────
# Source is pinned to the exact GKI build the phone runs (see workflow);
# vendor-module compatibility is the KMI gate's job.
REQ CONFIG_ARM64_4K_PAGES=y
REQ !CONFIG_MODULE_SIG_PROTECT
# /proc/config.gz + the in-image config this pipeline reads back
REQ CONFIG_IKCONFIG=y
OPT CONFIG_IKCONFIG_PROC=y

# ──────────────────────────── PERFORMANCE ───────────────────────────
# schedutil + EAS + uclamp were added to GKI for exactly this reason; the
# vendor side (FPSGO/GED/PPM/PBM) talks to them through the scheduler and keeps
# working as long as the scheduler ABI is untouched.
REQ CONFIG_CPU_FREQ=y
REQ CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
REQ CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
REQ CONFIG_ENERGY_MODEL=y
REQ CONFIG_UCLAMP_TASK=y
REQ CONFIG_UCLAMP_TASK_GROUP=y
REQ CONFIG_CPUSETS=y
REQ CONFIG_CGROUP_SCHED=y
# UClamp bucket count is ABI: it sizes the uclamp arrays inside struct rq, and
# the stock gold kernel (read out of its own boot.img) has 20. Keep 20 - the
# vendor scheduler modules (FPSGO/GED/PPM/PBM) were linked against that layout.
# (Was 5, "smoother"; that is a struct-layout change for zero measurable gain.)
OPT CONFIG_UCLAMP_BUCKETS_COUNT=20
OPT CONFIG_PM_DEVFREQ=y
OPT CONFIG_DEVFREQ_THERMAL=y
# Balanced / gaming / sustained are runtime profiles (tools/gold-profiles.sh),
# not configs: they must not bake a fixed policy into the kernel.

# ────────────────────────────── MEMORY ──────────────────────────────
REQ CONFIG_SWAP=y
REQ CONFIG_PSI=y
REQ !CONFIG_PSI_DEFAULT_DISABLED
REQ CONFIG_MEMCG=y
# zram compression algorithms (the zram driver itself stays Google's module)
REQ CONFIG_CRYPTO_LZ4=y
REQ CONFIG_CRYPTO_LZ4HC=y
REQ CONFIG_CRYPTO_LZO=y
OPT CONFIG_CRYPTO_842=y
OPT CONFIG_CRYPTO_ZSTD=y
# MGLRU: tested on this kernel family, on by default
REQ CONFIG_LRU_GEN=y
REQ CONFIG_LRU_GEN_ENABLED=y

# ───────────────────────────── STORAGE ──────────────────────────────
REQ CONFIG_EXT4_FS=y
REQ CONFIG_F2FS_FS=y
REQ CONFIG_EROFS_FS=y
OPT CONFIG_EROFS_FS_ZIP=y
OPT CONFIG_F2FS_FS_COMPRESSION=y
# file-based encryption + inline crypto (UFS 2.2 hardware key slots)
REQ CONFIG_FS_ENCRYPTION=y
REQ CONFIG_BLK_INLINE_ENCRYPTION=y
REQ CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
OPT CONFIG_SCSI_UFS_CRYPTO=y
# none (default mq-none, no config) + mq-deadline
REQ CONFIG_MQ_IOSCHED_DEADLINE=y
OPT CONFIG_SCSI_UFSHCD=y
OPT CONFIG_SCSI_UFS_BSG=y

# ────────────────────────────── POWER ───────────────────────────────
# Thermal stays exactly as stock: no bypass, no writable trips from userspace.
REQ CONFIG_THERMAL=y
REQ !CONFIG_THERMAL_WRITABLE_TRIPS
REQ CONFIG_CPU_IDLE=y
REQ CONFIG_ARM_PSCI_CPUIDLE=y
OPT CONFIG_CPU_IDLE_GOV_MENU=y
REQ CONFIG_SUSPEND=y
# suspend/wakelock statistics (/sys/power/suspend_stats)
OPT CONFIG_PM_SLEEP_DEBUG=y
# charge limit is userspace over the vendor power supply nodes
# (tools/gold-profiles.sh charge-limit); charging overclock is NOT implemented.

# ────────────────────────────── EXTRAS ──────────────────────────────
REQ CONFIG_WIREGUARD=y
REQ CONFIG_EXFAT_FS=y
REQ CONFIG_NTFS3_FS=y
REQ CONFIG_TMPFS_XATTR=y
# gamepads / HID
REQ CONFIG_HID_GENERIC=y
REQ CONFIG_INPUT_JOYDEV=y
OPT CONFIG_JOYSTICK_XPAD=y
OPT CONFIG_HID_PLAYSTATION=y
OPT CONFIG_HID_NINTENDO=y
OPT CONFIG_HID_SONY=y
OPT CONFIG_HID_MICROSOFT=y
# pstore / ramoops: last-kernel-log survives a reboot
REQ CONFIG_PSTORE=y
REQ CONFIG_PSTORE_RAM=y
REQ CONFIG_PSTORE_CONSOLE=y
OPT CONFIG_PSTORE_PMSG=y

# ───────────────────────────── NETWORKING ───────────────────────────
REQ CONFIG_TCP_CONG_BBR=y
REQ CONFIG_TCP_CONG_ADVANCED=y
# CONFIG_DEFAULT_TCP_CONG is derived from this choice (string has no prompt)
REQ CONFIG_DEFAULT_BBR=y
REQ CONFIG_NET_SCH_FQ=y
OPT CONFIG_NET_SCH_FQ_CODEL=y
# Extra qdiscs / network filesystems. All additive: a new built-in adds symbols,
# it does not change an existing symbol's CRC, so vendor modules keep loading
# (the KMI gate proves it either way).
OPT CONFIG_NET_SCH_CAKE=y
OPT CONFIG_CIFS=y
# IP set support - what firewall / ad-block apps (AFWall, NetGuard, AdAway's
# iptables mode) drive from userspace. Kernel side only; the apps bring rules.
OPT CONFIG_IP_SET=y
OPT CONFIG_IP_SET_HASH_IP=y
OPT CONFIG_IP_SET_HASH_NET=y
OPT CONFIG_NETFILTER_XT_SET=y

# ─────────────────────────── DO NOT INCLUDE ─────────────────────────
# Enforced by scripts/check-policy.sh, not by wishful thinking:
REQ CONFIG_SECURITY_SELINUX=y
REQ !CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE
REQ !CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE
