# gold-devbuild.config - "Ftrace/perf development build" extras.
#
# Applied only when the workflow input dev_build=true. Kept separate and off by
# default because:
#   * these symbols are debug infrastructure, not daily-driver features;
#   * ftrace/perf export additional symbols, and the GKI KMI symbol-list gate
#     (strict mode) is happiest when the Image stays close to stock;
#   * it makes the Image bigger for no runtime benefit to a normal user.
# Flip the input to true for a build you intend to profile with (perf, tracefs,
# systrace, simpleperf system-wide).

REQ CONFIG_PERF_EVENTS=y
REQ CONFIG_FUNCTION_TRACER=y
REQ CONFIG_DYNAMIC_FTRACE=y
REQ CONFIG_FTRACE_SYSCALLS=y
REQ CONFIG_KPROBE_EVENTS=y
OPT CONFIG_UPROBE_EVENTS=y
OPT CONFIG_FUNCTION_GRAPH_TRACER=y
OPT CONFIG_BLK_DEV_IO_TRACE=y
OPT CONFIG_ENABLE_DEFAULT_TRACERS=y
